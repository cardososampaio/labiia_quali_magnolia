{
  "compilerOptions": {
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "target": "ES2022",
    "types": ["node"],
    "baseUrl": ".",
    "paths": { "electron": ["src/helper/electron-shim.ts"] }
  },
  "include": ["src/helper/**/*", "src/renderer/models/lexical-api.ts", "src/renderer/models/lexical-figures.ts"]
}
