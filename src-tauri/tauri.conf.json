{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "labiia_quali",
  "version": "../package.json",
  "identifier": "br.labiia.quali",
  "build": {
    "beforeDevCommand": "npm run prepare:helper && npm run dev:web",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run prepare:helper && npm run build:web",
    "frontendDist": "../out/renderer"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": false
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "copyright": "Copyright © 2026 Cale Davis (Magnolia) e contribuidores do labiia_quali",
    "shortDescription": "Análise de dados qualitativos",
    "longDescription": "labiia_quali é um software livre de análise de dados qualitativos, baseado no Magnolia e no padrão REFI-QDA, com análises léxicas do labiia_lex.",
    "resources": {
      "../LICENSE": "LICENSE",
      "../THIRD-PARTY-LICENSES.txt": "THIRD-PARTY-LICENSES.txt",
      "../helper/dist/": "helper/",
      "../resources/lexical/": "lexical/"
    },
    "fileAssociations": [
      {
        "ext": [
          "qdpx"
        ],
        "name": "Projeto QDPX",
        "description": "Projeto REFI-QDA (labiia_quali)",
        "role": "Editor",
        "mimeType": "application/x-qdpx"
      },
      {
        "ext": [
          "qdc"
        ],
        "name": "Livro de códigos QDC",
        "description": "Livro de códigos REFI-QDA",
        "role": "Viewer",
        "mimeType": "application/x-qdc"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "externalBin": [
      "binaries/labiia-node"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/cardososampaio/labiia_quali_magnolia/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVEQzRDNUY3OTdBM0YxOTAKUldTUThhT1g5OFhFWFF4eUV2STEzaGQxNDZwQzV5eDdzdURmVWh3WG5tWlJORjlOMXd6Rm55U00K"
    }
  }
}
