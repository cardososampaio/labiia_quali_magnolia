{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "licenseFile": null,
    "resources": {
      "../build/installer/": null
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-",
      "hardenedRuntime": false,
      "files": {
        "Resources/document-icon.icns": "icons/document-icon.icns",
        "Resources/codebook-icon.icns": "icons/codebook-icon.icns"
      },
      "dmg": {
        "windowSize": { "width": 540, "height": 380 },
        "appPosition": { "x": 130, "y": 220 },
        "applicationFolderPosition": { "x": 410, "y": 220 }
      }
    }
  }
}
