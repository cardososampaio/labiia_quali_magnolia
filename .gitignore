node_modules/
out/
dist/

# Rust / Tauri build output, and release assets collected by scripts/release.mjs
target/
src-tauri/gen/
release/
.DS_Store
*.log

# Affinity Designer working files (heavy binaries; the exported PNG masters
# are committed instead) and their editor lock files
*.af
*~lock~

# ...but the tracked artwork sources in graphic_files keep their .af files:
# the icon source folder in full, plus the welcome-screen background.
# Transient ~lock~ files stay ignored even here.
!graphic_files/app_and_file_icons/**
graphic_files/app_and_file_icons/*~lock~
graphic_files/app_and_file_icons/.DS_Store
!graphic_files/welcome-bg.af

# Local / scratch / working materials — kept on disk, never tracked or uploaded
.claude/
working_materials/

# Review spreadsheets made by scripts/translation-review.mjs
translation-review/
# Captures and reports made by scripts/layout-check/run.mjs
layout-report/

# labiia_quali: the helper's bundle (npm run build:helper) and the Node runtime
# fetched for it (scripts/fetch-helper-node.mjs)
helper/dist/
src-tauri/binaries/

# Per-computer Cargo settings (e.g. a build folder outside protected folders)
.cargo/

# Installers copied here for testing (built artifacts, not source)
instalador/

# Reports of scripts/mac-check (photos, logs, results of a run)
mac-check-report/
